# ── Pi config repo — publish-safe .gitignore ──────────────────────────────
# Only these are tracked:
#   README.md, agent/AGENTS.md, agent/README.md, agent/settings.json
#   (canonical defaults — never overwritten on install),
#   agent/keybindings.json, agent/install.sh, agent/install.ps1,
#   agent/extensions
# Everything below is local/secret/build and MUST NOT be committed.

# Installer scratch: clone dirs, setup logs, local test targets (all under ~/.pi/tmp)
/tmp/
/temp/

# Secrets / trust / live session state
auth.json
trust.json
sessions/
pi-acp/
models-store.json
# Local model catalog cache (refreshed by pi, machine-local)
models.json

# Installed runtime + global bins
bin/
node_modules/
*.log

# Local backups created by the installer
*.bak/
*.bak.*

# Windows reserved-device / recursive-copy artifacts
themes/nul
themes/.pi/

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local overrides (untracked files only — agent/settings.json itself is
# tracked intentionally as the install seed and is unaffected by this)
web-search.json
taste/
taste.md
taste.json
