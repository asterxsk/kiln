# The tarball mirrors git: everything tracked ships (extensions, tests,
# themes, installers). This file exists ONLY to keep machine-local state,
# secrets, and disk junk out of the published package.
**/node_modules/
**/.git/
*.log

# secrets / live state (unanchored on purpose — aggressive)
auth.json
trust.json
models-store.json
models.json
sessions/

# machine-local config + caches (root and agent copies)
agent/settings.json
web-search.json
web-search-cache/

# personal taste data — never tracked, never published
/taste/
agent/taste/
taste.md
taste.json

# local-only runtime / scratch dirs
.pi/
tmp/
temp/
agent.bak.*
pi-acp/
agent/bin/
agent/npm/
agent/sessions/
agent/themes/.pi

# known untracked junk (not in git, must not ship either)
agent/extensions/distructive.ts
